{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/session-start.py"
          },
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/check-messages.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/check-messages.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/check-messages.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/check-messages.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(send-msg:*)",
      "Bash(sync-workspace:*)",
      "Bash(get-roster)",
      "Bash(wait-for-messages:*)",
      "Bash(mkdir -p __HOME_DIR__/.cc-dev-team/worktrees/*)",
      "Bash(git:*)",
      "Bash(cd:*)",
      "Bash(gh:*)",
      "Bash(pwd)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Architecting",
      "Engineering",
      "Brewing",
      "Crafting",
      "Forging",
      "Assembling",
      "Debugging",
      "Refactoring",
      "Compiling",
      "Deploying",
      "Orchestrating",
      "Synthesizing",
      "Scheming",
      "Plotting",
      "Conjuring",
      "Manifesting",
      "Contemplating",
      "Deliberating",
      "Strategizing",
      "Calculating"
    ]
  }
}
