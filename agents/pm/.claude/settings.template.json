{
  "allowExternalMdIncludes": [
    "__ORCHESTRATOR_DIR__/docs/*"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/session-start.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__ORCHESTRATOR_DIR__/hooks/check-pending.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(send-msg:*)",
      "Bash(rename-sessions:*)",
      "Bash(set-issue-bar:*)",
      "Bash(get-roster)",
      "Bash(git:*)",
      "Bash(cd:*)",
      "Bash(gh:*)",
      "Skill(new-feature)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Architecting",
      "Engineering",
      "Brewing",
      "Crafting",
      "Forging",
      "Assembling",
      "Debugging",
      "Refactoring",
      "Compiling",
      "Deploying",
      "Orchestrating",
      "Synthesizing",
      "Scheming",
      "Plotting",
      "Conjuring",
      "Manifesting",
      "Contemplating",
      "Deliberating",
      "Strategizing",
      "Calculating"
    ]
  }
}
